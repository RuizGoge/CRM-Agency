# =============================================================================
# CRM Leads — environment
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Every variable below is read exactly once, in a validated module. A missing or
# malformed value fails at boot, never at 11am on a Tuesday.
# =============================================================================

# --- Database -----------------------------------------------------------------
# Local dev: `npm run db:up` starts this exact database.
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm_dev

# Production uses TWO roles (Phase 5, ADR: privilege separation).
#   crm_migrator — owns the schema, used ONLY by the one-shot pre-deploy job.
#   crm_app      — the running processes. Has no UPDATE/DELETE on the money
#                  tables and no SELECT on the leaderboard projection.
# DATABASE_URL is crm_app. The migrator URL is never present in an app process.
# MIGRATOR_DATABASE_URL=

# --- Process topology ---------------------------------------------------------
# The three processes are ONE image. This variable is the entire fold/split
# mechanism (ADR-01 / ADR-S1). Rung 1 (pilot) runs all three folded; rung 2
# splits them. Separating later requires no redesign and no migration.
#   web    — SSR, the resource API, the SSE hub
#   worker — pg-boss: reminders, health probe, sweepers, the outbox relay
#   ingest — /webhooks/* and /intake/* only. This is the bulkhead.
PROCESS_ROLES=web,worker,ingest

# --- Application --------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Session signing. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-in-every-environment

# --- Aloware (Sprint 0 spike) -------------------------------------------------
# No value here is verified yet. Gate 11 of the Sprint-0 ladder establishes
# whether webhooks are signed, whether they retry, and with what vocabulary.
# ALOWARE_API_BASE=
# ALOWARE_API_TOKEN=
# ALOWARE_WEBHOOK_SECRET=

# 10DLC registration is in flight and may be rejected. When false, every SMS
# path returns a typed refusal and the UI shows the pending-registration banner.
# The full acceptance suite must pass with this set to false — that is the
# configuration the product actually launches in.
SMS_ENABLED=false

# --- Observability ------------------------------------------------------------
# SENTRY_DSN=
# AXIOM_TOKEN=

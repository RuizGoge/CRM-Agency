{
  "name": "crm-leads",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "db:reset": "docker compose -f docker/docker-compose.yml down -v",
    "db:generate": "tsx scripts/guard-db-generate.ts && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate && tsx --env-file-if-exists=.env scripts/grade-property-b.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:jobs": "tsx scripts/install-jobs.ts",
    "events:generate": "tsx scripts/generate-events.ts",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "perf": "npm run build && tsx scripts/check-perf-budgets.ts",
    "spike:receiver": "tsx --env-file-if-exists=.env scripts/spike/aloware-receiver.ts",
    "spike:probe": "tsx --env-file-if-exists=.env scripts/spike/aloware-probe.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run perf",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "isbot": "5.2.1",
    "pg-boss": "12.26.4",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "8.3.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "axe-core": "^4.12.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "^4.9.0",
    "husky": "9.1.7",
    "lighthouse": "^13.4.1",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}

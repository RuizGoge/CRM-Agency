      "checkConstraints": {
        "earnings_delta_nonzero_unless_repair": {
          "name": "earnings_delta_nonzero_unless_repair",
          "value": "\"app\".\"earnings_ledger\".\"delta_cents\" <> 0 OR \"app\".\"earnings_ledger\".\"entry_type\" = 'projection_repair'"
        },
        "earnings_currency_usd": {
          "name": "earnings_currency_usd",
          "value": "\"app\".\"earnings_ledger\".\"currency\" = 'USD'"
        },
        "earnings_sale_is_positive": {
          "name": "earnings_sale_is_positive",
          "value": "\"app\".\"earnings_ledger\".\"entry_type\" <> 'sale' OR \"app\".\"earnings_ledger\".\"delta_cents\" > 0"
        },
        "earnings_reversal_is_negative": {
          "name": "earnings_reversal_is_negative",
          "value": "\"app\".\"earnings_ledger\".\"entry_type\" <> 'reversal' OR \"app\".\"earnings_ledger\".\"delta_cents\" < 0"
        },
        "earnings_period_month_coherent": {
          "name": "earnings_period_month_coherent",
          "value": "\"app\".\"earnings_ledger\".\"period_month\" = date_trunc('month', \"app\".\"earnings_ledger\".\"period_day\")::date"
        },
        "earnings_period_week_coherent": {
          "name": "earnings_period_week_coherent",
          "value": "\"app\".\"earnings_ledger\".\"period_week\" = date_trunc('week', \"app\".\"earnings_ledger\".\"period_day\")::date"
        },
        "earnings_source_is_a_declared_input": {
          "name": "earnings_source_is_a_declared_input",
          "value": "\"app\".\"earnings_ledger\".\"entry_type\" IN ('manual_adjustment', 'projection_repair')\n          OR \"app\".\"earnings_ledger\".\"source_event_name\" IN ('opportunity.won', 'opportunity.value_changed',\n                                      'opportunity.reopened', 'contact.merged')"
        },
        "earnings_deal_context_present": {
          "name": "earnings_deal_context_present",
          "value": "\"app\".\"earnings_ledger\".\"entry_type\" IN ('manual_adjustment', 'projection_repair')\n          OR (\"app\".\"earnings_ledger\".\"opportunity_id\" IS NOT NULL AND \"app\".\"earnings_ledger\".\"contact_id\" IS NOT NULL\n              AND \"app\".\"earnings_ledger\".\"stage_name_snapshot\" IS NOT NULL AND \"app\".\"earnings_ledger\".\"stage_config_version\" IS NOT NULL)"
        }
      },
      "isRLSEnabled": false
    },
